PORT=5000
# Use 127.0.0.1 (not localhost) on Windows to avoid long hangs on IPv6 ::1 when the API listens on IPv4 only.
BACKEND_URL=http://127.0.0.1:5001
JWT_SECRET=change-me
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
# Abort upstream requests after this many ms (default 20000).
PROXY_TIMEOUT_MS=20000
